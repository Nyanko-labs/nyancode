{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#101a1f",
    "bgDark": "#0c1217",
    "bgHighlight": "#15242d",
    "surface": "#1d2c36",
    "overlay": "#2c3d4b",
    "fg": "#b6c5d3",
    "fgDim": "#5b7189",
    "fgSoft": "#dce2e8",
    "red": "#f65162",
    "coral": "#f37c4b",
    "apricot": "#ffa066",
    "yellow": "#f2c74b",
    "green": "#49d575",
    "teal": "#0cc7c2",
    "cyan": "#2bbcd5",
    "azure": "#2ba3c9",
    "blue": "#4486d5",
    "purple": "#be59d6",
    "violet": "#9d7bd8",
    "magenta": "#ff45d4",
    "pink": "#f95b95",
    "lBg": "#eef3f6",
    "lPanel": "#e2e9ee",
    "lElement": "#d3dde4",
    "lBorder": "#b9c7d1",
    "lFg": "#1f2f3a",
    "lMuted": "#5b7189",
    "lCyan": "#0f7f95",
    "lTeal": "#0a8f8b",
    "lBlue": "#2f68b4",
    "lPurple": "#8a3fb0",
    "lRed": "#c9243b",
    "lCoral": "#c25a2a",
    "lYellow": "#9a7a12",
    "lGreen": "#1f8a45"
  },
  "theme": {
    "primary":   { "dark": "cyan",     "light": "lCyan" },
    "secondary": { "dark": "violet",   "light": "lPurple" },
    "accent":    { "dark": "teal",     "light": "lTeal" },
    "error":     { "dark": "red",      "light": "lRed" },
    "warning":   { "dark": "yellow",   "light": "lYellow" },
    "success":   { "dark": "green",    "light": "lGreen" },
    "info":      { "dark": "azure",    "light": "lBlue" },
    "text":      { "dark": "fg",       "light": "lFg" },
    "textMuted": { "dark": "fgDim",    "light": "lMuted" },
    "background":        { "dark": "bg",          "light": "lBg" },
    "backgroundPanel":   { "dark": "bgDark",      "light": "lPanel" },
    "backgroundElement": { "dark": "surface",     "light": "lElement" },
    "border":        { "dark": "overlay",     "light": "lBorder" },
    "borderActive":  { "dark": "cyan",        "light": "lCyan" },
    "borderSubtle":  { "dark": "bgHighlight", "light": "lElement" },
    "diffAdded":   { "dark": "green",  "light": "lGreen" },
    "diffRemoved": { "dark": "red",    "light": "lRed" },
    "diffContext": { "dark": "fgDim",  "light": "lMuted" },
    "diffHunkHeader": { "dark": "azure", "light": "lBlue" },
    "diffHighlightAdded":   { "dark": "green", "light": "lGreen" },
    "diffHighlightRemoved": { "dark": "red",   "light": "lRed" },
    "diffAddedBg":   { "dark": "#12301f", "light": "#dff3e6" },
    "diffRemovedBg": { "dark": "#3a1a22", "light": "#f8dfe2" },
    "diffContextBg": { "dark": "bgDark",  "light": "lPanel" },
    "diffLineNumber":          { "dark": "fgDim",   "light": "lMuted" },
    "diffAddedLineNumberBg":   { "dark": "#12301f", "light": "#dff3e6" },
    "diffRemovedLineNumberBg": { "dark": "#3a1a22", "light": "#f8dfe2" },
    "markdownText":       { "dark": "fg",      "light": "lFg" },
    "markdownHeading":    { "dark": "cyan",    "light": "lCyan" },
    "markdownLink":       { "dark": "azure",   "light": "lBlue" },
    "markdownLinkText":   { "dark": "teal",    "light": "lTeal" },
    "markdownCode":       { "dark": "apricot", "light": "lCoral" },
    "markdownBlockQuote": { "dark": "fgDim",   "light": "lMuted" },
    "markdownEmph":       { "dark": "yellow",  "light": "lYellow" },
    "markdownStrong":     { "dark": "fgSoft",  "light": "lFg" },
    "markdownHorizontalRule": { "dark": "overlay", "light": "lBorder" },
    "markdownListItem":        { "dark": "teal",    "light": "lTeal" },
    "markdownListEnumeration": { "dark": "cyan",    "light": "lCyan" },
    "markdownImage":     { "dark": "violet", "light": "lPurple" },
    "markdownImageText": { "dark": "fgDim",  "light": "lMuted" },
    "markdownCodeBlock": { "dark": "fg",     "light": "lFg" },
    "syntaxComment":     { "dark": "fgDim",   "light": "lMuted" },
    "syntaxKeyword":     { "dark": "purple",  "light": "lPurple" },
    "syntaxFunction":    { "dark": "cyan",    "light": "lCyan" },
    "syntaxVariable":    { "dark": "fg",      "light": "lFg" },
    "syntaxString":      { "dark": "green",   "light": "lGreen" },
    "syntaxNumber":      { "dark": "apricot", "light": "lCoral" },
    "syntaxType":        { "dark": "teal",    "light": "lTeal" },
    "syntaxOperator":    { "dark": "azure",   "light": "lBlue" },
    "syntaxPunctuation": { "dark": "fgSoft",  "light": "lFg" }
  }
}
